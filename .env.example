MONGO_db=kadim_security
MONGO_USER=kadim
# ZORUNLU — boş bırakmayın; bilinen/varsayılan parola DESTEKLENMEZ (fail-fast).
# Üretim: openssl rand -base64 32
MONGO_PASS=

# JWT imzalama anahtarı — ZORUNLU, rastgele uzun bir değer yazın (örn: openssl rand -hex 32)
JWT_SECRET=

# (Opsiyonel) PDCP API anahtarı
PDCP_API_KEY=

# Kayıt sistemi — VARSAYILAN AÇIK: /register'dan hesap açılıp hemen giriş yapılabilir.
# İlk kullanıcıyı açtıktan sonra (dışa açık kurulumda) kapatmak isteyebilirsiniz:
# REGISTER_ENABLED=false
# AUTO_ACTIVATE_USERS=false   # false = yeni kullanıcılar admin onayı bekler
REGISTER_ENABLED=true
AUTO_ACTIVATE_USERS=true


CLAUDE_API_KEY=

# .env dosyasına ekle:
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEMINI_API_KEY=

# ============================================================
# Otonom Motor Ayarları (FAZ 0/1 iyileştirmeleri)
# ============================================================
# Nuclei severity tabanı: taramada gösterilecek EN DÜŞÜK önem seviyesi.
#   medium (varsayılan) = kurumsal denge (critical+high+medium)
#   low                 = daha geniş görünürlük (eksik header, versiyon ifşası dahil)
#   critical            = yalnız en kritikler (dar, eski davranış)
AUTONOMOUS_SEVERITY_FLOOR=medium

# LLM istihbarat subayı (danışman). Erişilemezse motor deterministik kural+graf ile çalışır.
# VARSAYILAN sağlayıcı artık UI'dan (AI Yapılandırması sayfası) seçilir ve DB'de tutulur.
# Buradaki değer yalnızca DB boşken İLK seed/fallback'tir (DB > .env).
# Sağlayıcı: "ollama" (local) | "deepseek" | "claude" | "gemini" — anahtarlar aşağıda .env'de.
# AUTONOMOUS_LLM_PROVIDER=ollama

# --- ollama (local — veri dışarı çıkmaz, bankacılık/KVKK için önerilen) ---
OLLAMA_URL=http://host.docker.internal:11434
AUTONOMOUS_MODEL=hf.co/empero-ai/Qwythos-9B-v2-GGUF:Q4_K_M

# --- deepseek (bulut — provider'ı deepseek yapıp anahtarı doldur) ---
# Hedef banner/teknoloji verisi harici sunucuya gider; hassas pentest'te tercih etme.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash   # daha güçlü ama pahalı: deepseek-v4-pro

# ============================================================
# Rapor / Analiz Motoru (ai-service)
# ============================================================
# Rapor/analiz/chat için VARSAYILAN sağlayıcı ve model UI'dan (AI Yapılandırması) seçilir ve
# DB'de tutulur. İstek açıkça bir provider/model verirse o override eder; vermezse DB varsayılanı
# (yoksa aşağıdaki .env seed'i) kullanılır (DB > .env). Anahtarlar aşağıda, yalnız .env'de.
# Sağlayıcı: ollama (local) | deepseek | claude | gemini
# AI_SERVICE_LLM_PROVIDER=ollama
# AI_SERVICE_LLM_MODEL=            # boş bırakılırsa sağlayıcının kendi varsayılan modeli kullanılır

# --- claude (bulut — Anthropic; veri dışarı ÇIKAR, hassas pentest'te dikkat) ---
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-5-sonnet-latest

# --- gemini (bulut — Google; veri dışarı ÇIKAR) ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Not: ollama/deepseek arasında ollama local'dir (veri dışarı çıkmaz, KVKK/bankacılık için
# önerilen). claude/gemini/deepseek bulut sağlayıcılardır; tarama verisi harici sunucuya gider.
# Aktif yapılandırmayı görmek ve bağlantı testi için: UI → AI Ayarları (/admin/ai-settings).

# ============================================================
# Kapsam Kapısı (Scope Guard) — pipeline/scope_guard.py
# ============================================================
# ÖNCE YETKİ, SONRA TARAMA. Dış-kutudan saldırgan-gibi tarayan bu üründe hedef-yetki kapısı
# tarama başlamadan zorlanır. BANKACILIK/engagement'ta MUTLAKA doldurun — boşsa her yetkili
# kullanıcı HERHANGİ bir hedefi tarayabilir (yetkisiz-tarama riski; startup'ta uyarı loglanır).
# Virgülle: domain (subdomain'leri kapsar) | IP | CIDR. Örn:
# AUTHORIZED_TARGETS=bank.com.tr,api.bank.com.tr,203.0.113.0/24
AUTHORIZED_TARGETS=
# İç-ağ (on-prem/lab) angajmanı: RFC1918/loopback hedeflere BİLİNÇLİ izin. Metadata uçları
# (169.254.169.254) bu açıkken bile yasaktır. Dış tarama için 'false' bırakın.
# ALLOW_PRIVATE_TARGETS=false

# ============================================================
# Otonom motor — LLM kill-switch & öğrenme
# ============================================================
# AUTONOMOUS_LLM_DISABLE=1 → motor hiç danışma yapmaz, SAF kural+graf ile karar verir
# (eval harness 'rules-only' kolu bunu kullanır; sağlayıcı arızasında deterministik-mod).
# AUTONOMOUS_LLM_DISABLE=0
# BRAIN_LEARN_ENABLED: ai-service'te /brain/learn route'u YOK (ölü stub). Gerçek öğrenme
# auto-scan'de exploit_memory'dedir. /learn implemente edilmeden 'true' yapmayın.
# BRAIN_LEARN_ENABLED=false
# ============================================================
# Vektör hafıza (Qdrant) — semantik benzerlik (anı/bulgu/payload)
# ============================================================
# Varsayılan KAPALI: embedding dış API maliyeti üretir; bilinçli açın.
# Qdrant düşerse motor sessiz degrade olur, tarama sürer (best-effort doktrin).
# VECTOR_MEMORY_ENABLED=0
# QDRANT_URL=http://qdrant:6333
# OpenAI-uyumlu /v1/embeddings model adı (örn: text-embedding-3-small, nomic-embed-text).
# Boşsa embedding üretilmez → vektör hafıza pasif.
# VECTOR_EMBED_MODEL=
# VECTOR_EMBED_BASE_URL=
# Embedding kökü boşsa otomatik çözülür: DEEPSEEK (key varsa) > OLLAMA /v1 (OpenAI-uyumlu).
# VECTOR_EMBED_BASE_URL=

# ============================================================
# Davranış denetimi (loop-guard) — SAF kural, LLM-token maliyeti YOK
# ============================================================
# Aynı araç eşik üstü tekrarlanırsa siege_score çarpanı (ceza) + narrate uyarısı.
# LOOP_GUARD_ENABLED=1
# LOOP_GUARD_SAME_LIMIT=5     # aynı aracın kaç koşusundan sonra ceza başlar
# LOOP_GUARD_PENALTY=0.55     # skor çarpanı (0.1-0.95; 1.0 = ceza yok)
